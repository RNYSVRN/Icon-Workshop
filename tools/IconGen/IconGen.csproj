<Project Sdk="Microsoft.NET.Sdk">
  <!-- Generates src/IconWorkshop/Assets/app.ico and app.png. Usage: dotnet run in this folder -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\..\src\IconWorkshop\Imaging\IcoWriter.cs" Link="IcoWriter.cs" />
  </ItemGroup>
</Project>
