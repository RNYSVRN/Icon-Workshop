<Project Sdk="Microsoft.NET.Sdk">
  <!-- Developer tool: imports an icon pack headless and prints statistics. Usage: dotnet run, then the apk, folder or zip path and an optional output folder -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\IconWorkshop\IconWorkshop.csproj" />
  </ItemGroup>
</Project>
