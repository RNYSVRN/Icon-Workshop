<Project Sdk="Microsoft.NET.Sdk">
  <!-- Developer test: assigns and restores icons on shortcuts in a temporary test folder only, and runs the program scan read-only -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\IconWorkshop\IconWorkshop.csproj" />
  </ItemGroup>
</Project>
