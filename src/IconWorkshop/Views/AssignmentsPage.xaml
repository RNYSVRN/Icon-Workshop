<UserControl x:Class="IconWorkshop.Views.AssignmentsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:IconWorkshop"
             xmlns:c="clr-namespace:IconWorkshop.Controls"
             xmlns:v="clr-namespace:IconWorkshop.Views">
    <UserControl.Resources>
        <DataTemplate x:Key="AssignmentItem" DataType="{x:Type v:AssignmentRow}">
            <Grid MinHeight="40">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Image Source="{Binding Icon}" Width="32" Height="32" Margin="0,0,16,0" RenderOptions.BitmapScalingMode="HighQuality" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                    <TextBlock Text="{Binding Name}" FontSize="14" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Details}" Style="{StaticResource CardDesc}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip="{Binding Target}" />
                </StackPanel>
                <Border Grid.Column="2" CornerRadius="10" Padding="10,3" Margin="12,0,12,0" VerticalAlignment="Center"
                        Background="{DynamicResource SystemFillColorCautionBackgroundBrush}"
                        Visibility="{Binding HasProblem, Converter={StaticResource BoolToVis}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource IconText}" Text="&#xE7BA;" FontSize="12" Margin="0,0,6,0"
                                   Foreground="{DynamicResource SystemFillColorCautionBrush}" />
                        <TextBlock Text="{Binding StatusText}" FontSize="12" />
                    </StackPanel>
                </Border>
                <Button Grid.Column="3" Padding="8,5" Click="RestoreOne_Click" Tag="{Binding}" VerticalAlignment="Center"
                        ToolTip="{x:Static v:ProgramsPage.RestoreText}" AutomationProperties.Name="{x:Static v:ProgramsPage.RestoreText}">
                    <TextBlock Style="{StaticResource IconText}" Text="&#xE7A7;" FontSize="13" />
                </Button>
            </Grid>
        </DataTemplate>

        <Style x:Key="StaticCardItem" TargetType="ListBoxItem" BasedOn="{StaticResource CardListItem}">
            <Setter Property="Cursor" Value="Arrow" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="12,0,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,16">
            <TextBlock Style="{StaticResource PageTitle}" Text="{x:Static local:Loc.NavAssignments}" />
            <TextBlock Style="{StaticResource PageSubtitle}">
                <Run Text="{x:Static local:Loc.AssignmentsSubtitle}" /><Run x:Name="CountText" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
            </TextBlock>
        </StackPanel>

        <!-- Maintenance cards and profiles -->
        <StackPanel Grid.Row="1">
        <UniformGrid Columns="2" Margin="-2,0,-2,0">
            <Border Style="{StaticResource Card}" Margin="2,0,2,4" Padding="18,16">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,12,0,0">
                        <Button x:Name="ReapplyButton" Style="{DynamicResource AccentButtonStyle}" Click="Reapply_Click">
                            <StackPanel Style="{StaticResource ButtonContent}">
                                <TextBlock Style="{StaticResource ButtonGlyph}" Text="&#xE72C;" />
                                <TextBlock Text="{x:Static v:AssignmentsPage.ReapplyText}" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                        <CheckBox x:Name="SignInSwitch" DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center"
                                  Click="SignInSwitch_Click" AutomationProperties.Name="{x:Static v:AssignmentsPage.SignInTitle}" />
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Text="{x:Static v:AssignmentsPage.SignInTitle}" Style="{StaticResource CardTitle}" />
                            <TextBlock x:Name="SignInDesc" Style="{StaticResource CardDesc}" />
                        </StackPanel>
                    </DockPanel>
                    <StackPanel>
                        <TextBlock Text="{x:Static v:AssignmentsPage.ReapplyTitle}" Style="{StaticResource CardTitle}" FontWeight="SemiBold" />
                        <TextBlock Text="{x:Static v:AssignmentsPage.ReapplyDesc}" Style="{StaticResource CardDesc}" FontSize="13" Margin="0,4,0,0" />
                    </StackPanel>
                </DockPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="2,0,2,4" Padding="18,16">
                <DockPanel>
                    <WrapPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                        <Button Click="Refresh_Click" Margin="0,0,8,8">
                            <StackPanel Style="{StaticResource ButtonContent}">
                                <TextBlock Style="{StaticResource ButtonGlyph}" Text="&#xE895;" />
                                <TextBlock Text="{x:Static v:AssignmentsPage.RefreshText}" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="ClearCacheButton" Click="ClearCache_Click" Margin="0,0,8,8">
                            <StackPanel Style="{StaticResource ButtonContent}">
                                <TextBlock Style="{StaticResource ButtonGlyph}" Text="&#xE74D;" />
                                <TextBlock Text="{x:Static v:AssignmentsPage.ClearCacheText}" />
                            </StackPanel>
                        </Button>
                    </WrapPanel>
                    <StackPanel>
                        <TextBlock Text="{x:Static v:AssignmentsPage.CacheTitle}" Style="{StaticResource CardTitle}" FontWeight="SemiBold" />
                        <TextBlock Text="{x:Static v:AssignmentsPage.CacheDesc}" Style="{StaticResource CardDesc}" FontSize="13" Margin="0,4,0,0" />
                    </StackPanel>
                </DockPanel>
            </Border>
        </UniformGrid>
        <Border Style="{StaticResource Card}" Padding="18,16" Margin="0,0,0,8">
            <DockPanel>
                <Border DockPanel.Dock="Left" Style="{StaticResource IconTile}" VerticalAlignment="Top">
                    <TextBlock Style="{StaticResource TileGlyph}" Text="&#xE77B;" />
                </Border>
                <StackPanel>
                    <TextBlock Text="{x:Static v:AssignmentsPage.ProfilesTitle}" Style="{StaticResource CardTitle}" FontWeight="SemiBold" />
                    <TextBlock Text="{x:Static v:AssignmentsPage.ProfilesDesc}" Style="{StaticResource CardDesc}" FontSize="13" Margin="0,4,0,10" />
                    <WrapPanel>
                        <ComboBox x:Name="ProfileBox" Width="260" DisplayMemberPath="Label" Margin="0,0,8,6" SelectionChanged="ProfileBox_SelectionChanged"
                                  AutomationProperties.Name="{x:Static v:AssignmentsPage.ProfilesTitle}" />
                        <Button x:Name="ProfileApplyButton" Margin="0,0,8,6" Click="ProfileApply_Click">
                            <StackPanel Style="{StaticResource ButtonContent}">
                                <TextBlock Style="{StaticResource ButtonGlyph}" Text="&#xE73E;" />
                                <TextBlock Text="{x:Static v:AssignmentsPage.ProfileApplyText}" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="ProfileDeleteButton" Margin="0,0,24,6" Padding="9,6" Click="ProfileDelete_Click"
                                ToolTip="{x:Static local:Loc.Delete}" AutomationProperties.Name="{x:Static local:Loc.Delete}">
                            <StackPanel Style="{StaticResource ButtonContent}"><TextBlock Style="{StaticResource IconText}" Text="&#xE74D;" /></StackPanel>
                        </Button>
                        <Button x:Name="ProfileSaveButton" Margin="0,0,0,6" Click="ProfileSave_Click">
                            <StackPanel Style="{StaticResource ButtonContent}">
                                <TextBlock Style="{StaticResource ButtonGlyph}" Text="&#xE74E;" />
                                <TextBlock Text="{x:Static v:AssignmentsPage.ProfileSaveText}" />
                            </StackPanel>
                        </Button>
                    </WrapPanel>
                </StackPanel>
            </DockPanel>
        </Border>
        </StackPanel>

        <!-- Result of the last action -->
        <Border x:Name="InfoBar" Grid.Row="2" Style="{StaticResource InfoBar}" Margin="0,0,0,12" Visibility="Collapsed">
            <DockPanel>
                <Button DockPanel.Dock="Right" Padding="6" VerticalAlignment="Top" Click="CloseInfo_Click"
                        Background="Transparent" BorderThickness="0" ToolTip="{x:Static local:Loc.Close}">
                    <TextBlock Style="{StaticResource IconText}" Text="&#xE711;" FontSize="11" />
                </Button>
                <TextBlock x:Name="InfoIcon" DockPanel.Dock="Left" Style="{StaticResource IconText}" FontSize="16" Margin="0,0,12,0" VerticalAlignment="Top" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="InfoTitle" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock x:Name="InfoText" Style="{StaticResource SecondaryText}" TextWrapping="Wrap" />
                </StackPanel>
            </DockPanel>
        </Border>
        <c:BusyBar x:Name="Busy" Grid.Row="3" Margin="0,0,0,12" Visibility="Collapsed" />

        <!-- Toolbar of the list -->
        <DockPanel Grid.Row="4" Margin="0,4,0,0" LastChildFill="False">
            <TextBlock Text="{x:Static v:AssignmentsPage.ListTitle}" Style="{StaticResource SectionTitle}" Margin="2,0,16,0" VerticalAlignment="Center" />
            <ComboBox x:Name="FilterBox" Width="190" DisplayMemberPath="Label" SelectionChanged="FilterBox_SelectionChanged" />
            <Button DockPanel.Dock="Right" x:Name="RestoreAllButton" Click="RestoreAll_Click" Margin="8,0,0,0">
                <StackPanel Style="{StaticResource ButtonContent}">
                    <TextBlock Style="{StaticResource ButtonGlyph}" Text="&#xE7A7;" />
                    <TextBlock Text="{x:Static v:AssignmentsPage.RestoreAllText}" />
                </StackPanel>
            </Button>
            <Button DockPanel.Dock="Right" Click="Import_Click" Margin="8,0,0,0">
                <StackPanel Style="{StaticResource ButtonContent}">
                    <TextBlock Style="{StaticResource ButtonGlyph}" Text="&#xE8B5;" />
                    <TextBlock Text="{x:Static v:AssignmentsPage.ImportText}" />
                </StackPanel>
            </Button>
            <Button DockPanel.Dock="Right" x:Name="ExportButton" Click="Export_Click">
                <StackPanel Style="{StaticResource ButtonContent}">
                    <TextBlock Style="{StaticResource ButtonGlyph}" Text="&#xEDE1;" />
                    <TextBlock Text="{x:Static v:AssignmentsPage.ExportText}" />
                </StackPanel>
            </Button>
        </DockPanel>

        <ListBox x:Name="List" Grid.Row="5" Style="{StaticResource CardList}" ItemTemplate="{StaticResource AssignmentItem}" ItemContainerStyle="{StaticResource StaticCardItem}"
                 BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled" Padding="0,0,8,0"
                 VirtualizingPanel.IsVirtualizingWhenGrouping="True">
            <ListBox.GroupStyle>
                <GroupStyle HeaderTemplate="{StaticResource GroupHeader}" ContainerStyle="{StaticResource PlainGroupItem}" />
            </ListBox.GroupStyle>
        </ListBox>
        <Border x:Name="EmptyState" Grid.Row="5" Style="{StaticResource Card}" Padding="24,20" VerticalAlignment="Top" Margin="0,12,0,0" Visibility="Collapsed">
            <DockPanel>
                <Border DockPanel.Dock="Left" Style="{StaticResource IconTile}" VerticalAlignment="Top">
                    <TextBlock Style="{StaticResource TileGlyph}" Text="&#xE81C;" />
                </Border>
                <StackPanel>
                    <TextBlock Text="{x:Static v:AssignmentsPage.EmptyTitle}" FontSize="15" FontWeight="SemiBold" />
                    <TextBlock Text="{x:Static v:AssignmentsPage.EmptyText}" Style="{StaticResource BodyText}" Margin="0,4,0,0" />
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
