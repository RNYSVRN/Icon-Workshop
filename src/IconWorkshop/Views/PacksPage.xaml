<UserControl x:Class="IconWorkshop.Views.PacksPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:IconWorkshop"
             xmlns:c="clr-namespace:IconWorkshop.Controls"
             xmlns:v="clr-namespace:IconWorkshop.Views">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12,0,4,0">
        <StackPanel MaxWidth="1100" HorizontalAlignment="Stretch">
            <!-- Header -->
            <TextBlock Style="{StaticResource PageTitle}" Text="{x:Static local:Loc.NavPacks}" />
            <TextBlock Style="{StaticResource PageSubtitle}" Margin="0,4,0,16">
                <Run Text="{x:Static local:Loc.PacksSubtitle}" /><Run x:Name="SummaryText" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
            </TextBlock>

            <!-- Toolbar -->
            <DockPanel Margin="0,0,0,12" LastChildFill="False">
                <Button x:Name="ImportApkButton" DockPanel.Dock="Left" Style="{DynamicResource AccentButtonStyle}" Click="ImportApk_Click"
                        ToolTip="{x:Static local:Loc.ImportApkTip}">
                    <StackPanel Style="{StaticResource ButtonContent}">
                        <TextBlock Style="{StaticResource ButtonGlyph}" Text="&#xE896;" />
                        <TextBlock Text="{x:Static local:Loc.ImportApk}" />
                    </StackPanel>
                </Button>
                <Button x:Name="ImportFolderButton" DockPanel.Dock="Left" Margin="8,0,0,0" Click="ImportFolder_Click"
                        ToolTip="{x:Static local:Loc.ImportFolderTip}">
                    <StackPanel Style="{StaticResource ButtonContent}">
                        <TextBlock Style="{StaticResource ButtonGlyph}" Text="&#xE8DA;" />
                        <TextBlock Text="{x:Static local:Loc.ImportFolder}" />
                    </StackPanel>
                </Button>
            </DockPanel>

            <!-- Import progress -->
            <Border x:Name="ProgressCard" Style="{StaticResource Card}" Margin="0,0,0,12" Visibility="Collapsed">
                <StackPanel>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="{x:Static local:Loc.Cancel}" Click="CancelImport_Click" />
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="ProgressTitle" Style="{StaticResource CardTitle}" FontWeight="SemiBold" />
                            <TextBlock x:Name="ProgressText" Style="{StaticResource CardDesc}" />
                        </StackPanel>
                    </DockPanel>
                    <ProgressBar x:Name="ProgressBar" Margin="0,12,0,0" Height="4" Minimum="0" Maximum="1" />
                    <c:BusyBar x:Name="ProgressBusy" Margin="0,12,0,0" Visibility="Collapsed" />
                </StackPanel>
            </Border>

            <!-- Result of the last import -->
            <Border x:Name="InfoBar" Style="{StaticResource InfoBar}" Margin="0,0,0,12" Visibility="Collapsed">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Padding="6" VerticalAlignment="Top" Click="CloseInfo_Click"
                            Background="Transparent" BorderThickness="0" ToolTip="{x:Static local:Loc.Close}">
                        <TextBlock Style="{StaticResource IconText}" Text="&#xE711;" FontSize="11" />
                    </Button>
                    <TextBlock x:Name="InfoIcon" DockPanel.Dock="Left" Style="{StaticResource IconText}" FontSize="16" Margin="0,0,12,0" VerticalAlignment="Top" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="InfoTitle" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock x:Name="InfoText" Style="{StaticResource SecondaryText}" TextWrapping="Wrap" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Pack list -->
            <ItemsControl x:Name="PackList" Focusable="False">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type v:PackRow}">
                        <Border Style="{StaticResource Card}" Padding="18,16">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Meta}" Style="{StaticResource CardDesc}" FontSize="13" />
                                    <TextBlock Text="{Binding Source}" Style="{StaticResource CardDesc}" TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" ToolTip="{Binding SourceFull}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                                    <Button Click="Browse_Click" Tag="{Binding}">
                                        <StackPanel Style="{StaticResource ButtonContent}">
                                            <TextBlock Style="{StaticResource ButtonGlyph}" Text="&#xE8B9;" />
                                            <TextBlock Text="{x:Static local:Loc.Browse}" />
                                        </StackPanel>
                                    </Button>
                                    <Button Margin="8,0,0,0" Padding="9,6" Click="Rename_Click" Tag="{Binding}"
                                            ToolTip="{x:Static local:Loc.Rename}" AutomationProperties.Name="{x:Static local:Loc.Rename}">
                                        <TextBlock Style="{StaticResource IconText}" Text="&#xE8AC;" />
                                    </Button>
                                    <Button Margin="8,0,0,0" Padding="9,6" Click="OpenFolder_Click" Tag="{Binding}"
                                            ToolTip="{x:Static local:Loc.ShowInExplorer}" AutomationProperties.Name="{x:Static local:Loc.ShowInExplorer}">
                                        <TextBlock Style="{StaticResource IconText}" Text="&#xE838;" />
                                    </Button>
                                    <Button Margin="8,0,0,0" Padding="9,6" Click="Delete_Click" Tag="{Binding}"
                                            ToolTip="{x:Static local:Loc.Delete}" AutomationProperties.Name="{x:Static local:Loc.Delete}">
                                        <TextBlock Style="{StaticResource IconText}" Text="&#xE74D;" />
                                    </Button>
                                </StackPanel>
                                <!-- Sample strip: shows the style of the pack at a glance -->
                                <Border Grid.Row="1" Grid.ColumnSpan="2" Margin="0,14,0,0" Padding="12,10" CornerRadius="6" ClipToBounds="True"
                                        Background="{DynamicResource ControlFillColorSecondaryBrush}">
                                    <ItemsControl ItemsSource="{Binding Samples}" Focusable="False">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Image Source="{Binding}" Width="40" Height="40" Margin="0,0,14,0" RenderOptions.BitmapScalingMode="HighQuality" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- No packs yet -->
            <Border x:Name="EmptyState" Style="{StaticResource Card}" Padding="28,26" Visibility="Collapsed">
                <DockPanel>
                    <Border DockPanel.Dock="Left" Style="{StaticResource IconTile}" Width="56" Height="56" Margin="0,0,20,0" VerticalAlignment="Top">
                        <TextBlock Style="{StaticResource TileGlyph}" Text="&#xE7B8;" FontSize="24" />
                    </Border>
                    <StackPanel>
                        <TextBlock Text="{x:Static local:Loc.NoPacksTitle}" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock Style="{StaticResource BodyText}" Text="{x:Static local:Loc.NoPacksText}" Margin="0,6,0,0" />
                    </StackPanel>
                </DockPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
