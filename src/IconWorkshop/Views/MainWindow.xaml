<Window x:Class="IconWorkshop.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:IconWorkshop"
        xmlns:v="clr-namespace:IconWorkshop.Views"
        Title="{x:Static local:AppInfo.Title}"
        Icon="/Assets/app.ico"
        Width="1180" Height="780" MinWidth="720" MinHeight="500"
        WindowStartupLocation="CenterScreen" AllowDrop="True"
        Foreground="{DynamicResource TextFillColorPrimaryBrush}">

    <!-- Content reaches into the title bar (app icon + name there, like Windows 11 apps);
         Windows still draws the caption buttons, incl. snap layouts -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="48" GlassFrameThickness="-1" ResizeBorderThickness="6" UseAeroCaptionButtons="True" CornerRadius="0"
                      NonClientFrameEdges="Left,Right,Bottom" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Nav item with an optional divider above it. The divider sits outside the hover/selection
             surface, so the highlight only covers the item itself. -->
        <Style x:Key="MainNavItemStyle" TargetType="ListBoxItem" BasedOn="{StaticResource NavItemStyle}">
            <Setter Property="Margin" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <StackPanel>
                            <Border Style="{StaticResource NavSeparator}" Margin="12,7,12,8" IsHitTestVisible="False"
                                    Visibility="{Binding SeparatorBefore, Converter={StaticResource BoolToVis}}" />
                            <Grid x:Name="Surface" Margin="0,1" Background="Transparent">
                                <Border x:Name="Bg" CornerRadius="4" Background="Transparent" />
                                <Border x:Name="Pill" Width="3" Height="16" CornerRadius="1.5" HorizontalAlignment="Left"
                                        Background="{DynamicResource AccentFillColorDefaultBrush}" Visibility="Collapsed" />
                                <ContentPresenter Margin="16,0,12,0" />
                            </Grid>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger SourceName="Surface" Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                <Setter TargetName="Pill" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="NavItem">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Height="36" ToolTip="{Binding Label}" Background="Transparent">
                    <TextBlock Style="{StaticResource NavGlyph}" Text="{Binding Glyph}" />
                    <TextBlock Text="{Binding Label}" FontSize="14" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCompact, RelativeSource={RelativeSource AncestorType=v:MainWindow}}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </StackPanel>
        </DataTemplate>

        <!-- Settings entry at the bottom of the navigation: looks like a nav item -->
        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <!-- Own template: the text color must come from the theme explicitly, like the nav items -->
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" CornerRadius="4" Background="Transparent" Height="36">
                            <ContentPresenter Margin="16,0,12,0" VerticalAlignment="Center" HorizontalAlignment="Left" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Title bar: app icon and name, aligned with the navigation icons -->
        <StackPanel x:Name="TitleBar" Orientation="Horizontal" VerticalAlignment="Center" Margin="21,2,0,0">
            <Image Source="/Assets/app.png" Width="18" Height="18" RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Center" />
            <TextBlock Text="{x:Static local:Loc.AppName}" FontSize="12" Margin="16,0,0,0" VerticalAlignment="Center" />
        </StackPanel>

        <Grid x:Name="MainView" Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="NavColumn" Width="272" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Left column: menu toggle, navigation, settings (directly on the window background) -->
            <DockPanel Margin="4,0,4,8">
                <Button DockPanel.Dock="Top" Style="{StaticResource NavButton}" Click="NavToggle_Click" Margin="0,0,0,6"
                        ToolTip="{x:Static local:Loc.NavToggle}" AutomationProperties.Name="{x:Static local:Loc.NavToggle}">
                    <TextBlock Style="{StaticResource NavGlyph}" Text="&#xE700;" FontSize="16" Margin="0" />
                </Button>

                <Button DockPanel.Dock="Bottom" Style="{StaticResource NavButton}" Click="Settings_Click"
                        ToolTip="{x:Static local:Loc.Settings}" AutomationProperties.Name="{x:Static local:Loc.Settings}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource NavGlyph}" Text="&#xE713;" />
                        <TextBlock x:Name="SettingsLabel" Text="{x:Static local:Loc.Settings}" FontSize="14" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Border DockPanel.Dock="Bottom" Style="{StaticResource NavSeparator}" Margin="12,8,12,8" />

                <ListBox x:Name="Nav" ItemTemplate="{StaticResource NavItem}" ItemContainerStyle="{StaticResource MainNavItemStyle}"
                         BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         SelectionChanged="Nav_SelectionChanged" />
            </DockPanel>

            <!-- Page: one step lighter than the window, with a rounded corner (like Windows 11 Settings) -->
            <Border Grid.Column="1" Style="{StaticResource ContentLayer}">
            <DockPanel Margin="12,16,24,16">
                <!-- "Assign to" from the library: which icon is waiting for a target -->
                <Border x:Name="PendingBar" DockPanel.Dock="Top" Style="{StaticResource InfoBar}" Margin="12,0,0,12" Visibility="Collapsed"
                        Background="{DynamicResource SystemFillColorAttentionBackgroundBrush}">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="{x:Static local:Loc.Cancel}" Click="CancelPending_Click" VerticalAlignment="Center" />
                        <Image x:Name="PendingImage" DockPanel.Dock="Left" Width="32" Height="32" Margin="0,0,12,0" RenderOptions.BitmapScalingMode="HighQuality" />
                        <TextBlock x:Name="PendingText" VerticalAlignment="Center" TextWrapping="Wrap" FontSize="13" Margin="0,0,12,0" />
                    </DockPanel>
                </Border>
                <ContentControl x:Name="PageHost" Focusable="False" />
            </DockPanel>
            </Border>
        </Grid>

        <!-- Settings: in the same window, like HDD-Spindown -->
        <v:SettingsView x:Name="SettingsPanel" Grid.Row="1" Visibility="Collapsed" />

        <!-- Drop zone while dragging a file over the window -->
        <Border x:Name="DropOverlay" Grid.RowSpan="2" Visibility="Collapsed" IsHitTestVisible="False" Margin="12"
                CornerRadius="12" BorderThickness="2" Background="{DynamicResource SmokeFillColorDefaultBrush}"
                BorderBrush="{DynamicResource AccentFillColorDefaultBrush}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Style="{StaticResource IconText}" Text="&#xE896;" FontSize="40" HorizontalAlignment="Center"
                           Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                <TextBlock Text="{x:Static local:Loc.DropHint}" FontSize="20" FontWeight="SemiBold" Margin="0,12,0,0" HorizontalAlignment="Center" />
            </StackPanel>
        </Border>

        <!-- Dimming while a dialog is open -->
        <Border x:Name="Smoke" Grid.RowSpan="2" Background="#66000000" Visibility="Collapsed" />
    </Grid>
</Window>
