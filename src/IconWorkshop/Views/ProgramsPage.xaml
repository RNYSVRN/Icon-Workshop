<UserControl x:Class="IconWorkshop.Views.ProgramsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:IconWorkshop"
             xmlns:c="clr-namespace:IconWorkshop.Controls"
             xmlns:v="clr-namespace:IconWorkshop.Views">
    <UserControl.Resources>
        <DataTemplate x:Key="ProgramItem" DataType="{x:Type v:ProgramRow}">
            <Grid Height="40">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Image Source="{Binding Icon}" Width="32" Height="32" Margin="0,0,16,0" RenderOptions.BitmapScalingMode="HighQuality" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}" FontSize="14" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Subtitle}" Style="{StaticResource CardDesc}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                </StackPanel>
                <Border Grid.Column="2" CornerRadius="10" Padding="10,3" Margin="12,0,12,0" VerticalAlignment="Center"
                        Background="{DynamicResource AccentFillColorDefaultBrush}"
                        Visibility="{Binding IsChanged, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{Binding ChangedLabel}" FontSize="12" Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                </Border>
                <TextBlock Grid.Column="3" Style="{StaticResource IconText}" Text="&#xE76C;" FontSize="12"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="ProgramTile" DataType="{x:Type v:ProgramRow}">
            <Grid ToolTip="{Binding Subtitle}">
                <StackPanel VerticalAlignment="Center" Margin="8,0">
                    <Image Source="{Binding Icon}" Width="48" Height="48" RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Text="{Binding Name}" FontSize="12" Margin="0,10,0,0" TextAlignment="Center" Height="32"
                               TextWrapping="Wrap" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <Border Style="{StaticResource ChangedDot}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,6,6,0"
                        ToolTip="{Binding ChangedLabel}" Visibility="{Binding IsChanged, Converter={StaticResource BoolToVis}}">
                    <TextBlock Style="{StaticResource IconText}" Text="&#xE73E;" FontSize="10" HorizontalAlignment="Center"
                               Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                </Border>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="ShortcutItem" DataType="{x:Type v:ShortcutRow}">
            <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="ShortcutLabel" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <CheckBox IsChecked="{Binding IsChecked}" VerticalAlignment="Center" MinWidth="0" Padding="8,0,0,0"
                          AutomationProperties.Name="{Binding Label}" Checked="Shortcut_Toggled" Unchecked="Shortcut_Toggled">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Label}" FontSize="14" />
                        <TextBlock Style="{StaticResource IconText}" Text="&#xE72E;" FontSize="12" Margin="8,1,0,0"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   ToolTip="{x:Static v:ProgramsPage.AdminTip}"
                                   Visibility="{Binding NeedsAdmin, Converter={StaticResource BoolToVis}}" />
                        <Border CornerRadius="8" Padding="8,1" Margin="8,0,0,0" VerticalAlignment="Center"
                                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                Visibility="{Binding IsChanged, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{x:Static v:ProgramsPage.ChangedText}" FontSize="11" />
                        </Border>
                    </StackPanel>
                </CheckBox>
                <TextBlock Grid.Column="1" Text="{Binding Path}" ToolTip="{Binding Path}" Style="{StaticResource CardDesc}"
                           TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" VerticalAlignment="Center" Margin="12,0,8,0"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                <Button Grid.Column="2" Padding="7,4" Click="RevealShortcut_Click" Tag="{Binding Path}"
                        ToolTip="{x:Static local:Loc.ShowInExplorer}" AutomationProperties.Name="{x:Static local:Loc.ShowInExplorer}">
                    <TextBlock Style="{StaticResource IconText}" Text="&#xE838;" FontSize="12" />
                </Button>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="12,0,0,0">
        <!-- ===================== List ===================== -->
        <Grid x:Name="ListView">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Margin="0,0,0,16">
                <TextBlock Style="{StaticResource PageTitle}" Text="{x:Static local:Loc.NavPrograms}" />
                <TextBlock Style="{StaticResource PageSubtitle}">
                    <Run Text="{x:Static local:Loc.ProgramsSubtitle}" /><Run x:Name="CountText" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                </TextBlock>
            </StackPanel>

            <Grid Grid.Row="1" Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid>
                    <TextBox x:Name="SearchBox" TextChanged="SearchBox_TextChanged" Padding="10,6,32,6" VerticalContentAlignment="Center"
                             AutomationProperties.Name="{x:Static v:ProgramsPage.SearchText}" />
                    <TextBlock x:Name="SearchHint" Text="{x:Static v:ProgramsPage.SearchText}" IsHitTestVisible="False"
                               Margin="12,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                    <TextBlock Style="{StaticResource IconText}" Text="&#xE721;" FontSize="13" HorizontalAlignment="Right" Margin="0,0,12,0"
                               IsHitTestVisible="False" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </Grid>
                <ComboBox x:Name="FilterBox" Grid.Column="1" Width="210" Margin="8,0,0,0" DisplayMemberPath="Label"
                          SelectionChanged="FilterBox_SelectionChanged" AutomationProperties.Name="Filter" />
                <Border Grid.Column="2" Style="{StaticResource SegmentBar}" Margin="8,0,0,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="ListModeButton" Style="{StaticResource SegmentButton}" Content="&#xE8FD;" GroupName="ProgramsView"
                                     ToolTip="{x:Static v:ProgramsPage.AsListText}" AutomationProperties.Name="{x:Static v:ProgramsPage.AsListText}" Click="ViewMode_Click" />
                        <RadioButton x:Name="TileModeButton" Style="{StaticResource SegmentButton}" Content="&#xF0E2;" GroupName="ProgramsView"
                                     ToolTip="{x:Static v:ProgramsPage.AsTilesText}" AutomationProperties.Name="{x:Static v:ProgramsPage.AsTilesText}" Click="ViewMode_Click" />
                    </StackPanel>
                </Border>
                <Button x:Name="RescanButton" Grid.Column="3" Margin="8,0,0,0" Click="Rescan_Click">
                    <StackPanel Style="{StaticResource ButtonContent}">
                        <TextBlock Style="{StaticResource ButtonGlyph}" Text="&#xE72C;" />
                        <TextBlock Text="{x:Static v:ProgramsPage.RescanText}" />
                    </StackPanel>
                </Button>
                <Button x:Name="SuggestButton" Grid.Column="4" Margin="8,0,0,0" Click="Suggest_Click" Style="{DynamicResource AccentButtonStyle}"
                        ToolTip="{x:Static v:SuggestionsView.SubtitleText}">
                    <StackPanel Style="{StaticResource ButtonContent}">
                        <TextBlock Style="{StaticResource ButtonGlyph}" Text="&#xE82F;" />
                        <TextBlock Text="{x:Static v:ProgramsPage.SuggestText}" />
                    </StackPanel>
                </Button>
            </Grid>

            <c:BusyBar x:Name="ScanBusy" Grid.Row="2" Margin="0,8,0,0" Visibility="Collapsed" />

            <!-- Grouped A-Z like "All apps" in the Start menu -->
            <ListBox x:Name="ProgramList" Grid.Row="3" Style="{StaticResource CardList}" ItemTemplate="{StaticResource ProgramItem}" ItemContainerStyle="{StaticResource CardListItem}"
                     VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                     SelectionMode="Single" PreviewMouseLeftButtonUp="ProgramList_Click" KeyDown="ProgramList_KeyDown">
                <ListBox.GroupStyle>
                    <GroupStyle HeaderTemplate="{StaticResource GroupHeader}" ContainerStyle="{StaticResource PlainGroupItem}" />
                </ListBox.GroupStyle>
            </ListBox>
            <ListBox x:Name="ProgramTiles" Grid.Row="3" Style="{StaticResource TileList}" ItemTemplate="{StaticResource ProgramTile}" ItemContainerStyle="{StaticResource TileListItem}"
                     SelectionMode="Single" PreviewMouseLeftButtonUp="ProgramList_Click" KeyDown="ProgramList_KeyDown" Visibility="Collapsed">
                <ListBox.GroupStyle>
                    <GroupStyle HeaderTemplate="{StaticResource GroupHeader}" ContainerStyle="{StaticResource PlainGroupItem}" />
                </ListBox.GroupStyle>
            </ListBox>

            <TextBlock x:Name="ListEmpty" Grid.Row="3" Text="{x:Static v:ProgramsPage.NoProgramsText}" HorizontalAlignment="Center"
                       VerticalAlignment="Top" Margin="0,40,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Visibility="Collapsed" />
        </Grid>

        <!-- ===================== Suggestion wizard ===================== -->
        <v:SuggestionsView x:Name="Suggestions" Visibility="Collapsed" />

        <!-- ===================== Detail ===================== -->
        <Grid x:Name="DetailView" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" MinHeight="200" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Breadcrumb -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                <Button Style="{StaticResource LinkButton}" Content="{x:Static local:Loc.NavPrograms}" Click="Back_Click" FontSize="14" />
                <TextBlock Style="{StaticResource IconText}" Text="&#xE76C;" FontSize="10" Margin="10,1,10,0"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <TextBlock Text="{x:Static v:ProgramsPage.ChooseIconText}" FontSize="14" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </StackPanel>
            <TextBlock x:Name="DetailTitle" Grid.Row="1" Style="{StaticResource PageTitle}" TextTrimming="CharacterEllipsis" Margin="0,0,0,12" />

            <!-- Shortcuts and before/after -->
            <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Top" Margin="0,0,24,0">
                        <StackPanel>
                            <Border Width="64" Height="64" CornerRadius="8" Background="{DynamicResource ControlFillColorSecondaryBrush}">
                                <Image x:Name="CurrentIcon" Width="48" Height="48" RenderOptions.BitmapScalingMode="HighQuality" />
                            </Border>
                            <TextBlock Text="{x:Static v:ProgramsPage.CurrentText}" Style="{StaticResource CardDesc}" HorizontalAlignment="Center" Margin="0,6,0,0" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource IconText}" Text="&#xE72A;" FontSize="16" Margin="12,0,12,20"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <StackPanel>
                            <Border Width="64" Height="64" CornerRadius="8" BorderThickness="1"
                                    BorderBrush="{DynamicResource AccentFillColorDefaultBrush}" Background="{DynamicResource ControlFillColorSecondaryBrush}">
                                <Grid>
                                    <Image x:Name="NewIcon" Width="48" Height="48" RenderOptions.BitmapScalingMode="HighQuality" />
                                    <TextBlock x:Name="NewIconPlaceholder" Style="{StaticResource IconText}" Text="&#xE8B9;" FontSize="20"
                                               HorizontalAlignment="Center" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                </Grid>
                            </Border>
                            <TextBlock Text="{x:Static v:ProgramsPage.NewText}" Style="{StaticResource CardDesc}" HorizontalAlignment="Center" Margin="0,6,0,0" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="1">
                        <!-- Existing shortcuts -->
                        <StackPanel x:Name="ShortcutPanel">
                            <TextBlock x:Name="ShortcutHeader" Style="{StaticResource CardTitle}" FontWeight="SemiBold" Margin="0,0,0,8" />
                            <ScrollViewer MaxHeight="150" VerticalScrollBarVisibility="Auto">
                                <ItemsControl x:Name="ShortcutList" ItemTemplate="{StaticResource ShortcutItem}" Focusable="False" Grid.IsSharedSizeScope="True" />
                            </ScrollViewer>
                        </StackPanel>
                        <!-- Program without shortcut: create own ones -->
                        <StackPanel x:Name="CreatePanel">
                            <TextBlock Text="{x:Static v:ProgramsPage.CreateHeader}" Style="{StaticResource CardTitle}" FontWeight="SemiBold" />
                            <TextBlock Text="{x:Static v:ProgramsPage.CreateDesc}" Style="{StaticResource CardDesc}" Margin="0,2,0,10" />
                            <StackPanel Orientation="Horizontal">
                                <CheckBox x:Name="CreateDesktop" Content="{x:Static v:ProgramsPage.OnDesktop}" IsChecked="True" Margin="0,0,24,0" Click="CreateTarget_Click" />
                                <CheckBox x:Name="CreateStart" Content="{x:Static v:ProgramsPage.InStartMenu}" IsChecked="True" Click="CreateTarget_Click" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Result of the last action -->
            <Border x:Name="InfoBar" Grid.Row="3" Style="{StaticResource InfoBar}" Margin="0,0,0,12" Visibility="Collapsed">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Padding="6" VerticalAlignment="Top" Click="CloseInfo_Click"
                            Background="Transparent" BorderThickness="0" ToolTip="{x:Static local:Loc.Close}">
                        <TextBlock Style="{StaticResource IconText}" Text="&#xE711;" FontSize="11" />
                    </Button>
                    <TextBlock x:Name="InfoIcon" DockPanel.Dock="Left" Style="{StaticResource IconText}" FontSize="16" Margin="0,0,12,0" VerticalAlignment="Top" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="InfoTitle" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock x:Name="InfoText" Style="{StaticResource SecondaryText}" TextWrapping="Wrap" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <c:IconBrowser x:Name="Browser" Grid.Row="4" />

            <!-- Action bar -->
            <Border Grid.Row="5" Style="{StaticResource Card}" Margin="0,12,0,0" Padding="16,12">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Click="Generate_Click" Margin="0,0,8,0" ToolTip="{x:Static v:ProgramsPage.GenerateTip}">
                            <StackPanel Style="{StaticResource ButtonContent}">
                                <TextBlock Style="{StaticResource ButtonGlyph}" Text="&#xE945;" />
                                <TextBlock Text="{x:Static v:ProgramsPage.GenerateText}" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="RestoreButton" Click="Restore_Click" Margin="0,0,8,0">
                            <StackPanel Style="{StaticResource ButtonContent}">
                                <TextBlock Style="{StaticResource ButtonGlyph}" Text="&#xE7A7;" />
                                <TextBlock Text="{x:Static v:ProgramsPage.RestoreText}" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="ApplyButton" Style="{DynamicResource AccentButtonStyle}" Click="Apply_Click" MinWidth="140">
                            <StackPanel Style="{StaticResource ButtonContent}">
                                <TextBlock Style="{StaticResource ButtonGlyph}" Text="&#xE73E;" />
                                <TextBlock Text="{x:Static v:ProgramsPage.ApplyText}" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock x:Name="ActionTitle" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="ActionText" Style="{StaticResource CardDesc}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                    </StackPanel>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
