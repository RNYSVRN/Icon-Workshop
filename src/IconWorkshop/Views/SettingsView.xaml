<UserControl x:Class="IconWorkshop.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:IconWorkshop"
             xmlns:c="clr-namespace:IconWorkshop.Controls"
             xmlns:v="clr-namespace:IconWorkshop.Views">

    <UserControl.Resources>
        <DataTemplate x:Key="TopicHeader" DataType="{x:Type v:HelpTopic}">
            <DockPanel>
                <Border DockPanel.Dock="Left" Style="{StaticResource IconTile}">
                    <TextBlock Style="{StaticResource TileGlyph}" Text="{Binding Glyph}" />
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource CardTitle}" Text="{Binding Title}" />
                    <TextBlock Style="{StaticResource CardDesc}" Text="{Binding Summary}" />
                </StackPanel>
            </DockPanel>
        </DataTemplate>

        <DataTemplate x:Key="BulletItem" DataType="{x:Type v:HelpItem}">
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Ellipse Width="5" Height="5" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="2,9,0,0"
                         Fill="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                <StackPanel Grid.Column="1">
                    <TextBlock Text="{Binding Label}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap"
                               Visibility="{Binding HasLabel, Converter={StaticResource BoolToVis}}" />
                    <TextBlock Style="{StaticResource BodyText}" Text="{Binding Text}" />
                </StackPanel>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="TopicBody" DataType="{x:Type v:HelpTopic}">
            <StackPanel>
                <TextBlock Style="{StaticResource BodyText}" Text="{Binding Intro}" Margin="0,0,0,12"
                           Visibility="{Binding HasIntro, Converter={StaticResource BoolToVis}}" />
                <ItemsControl ItemsSource="{Binding Items}" ItemTemplate="{StaticResource BulletItem}"
                              Visibility="{Binding HasItems, Converter={StaticResource BoolToVis}}" />
                <TextBlock Style="{StaticResource BodyText}" Text="{Binding Outro}" Margin="0,2,0,0"
                           Visibility="{Binding HasOutro, Converter={StaticResource BoolToVis}}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="TopicExpander" DataType="{x:Type v:HelpTopic}">
            <Expander Style="{StaticResource SettingsExpander}" Header="{Binding}" HeaderTemplate="{StaticResource TopicHeader}"
                      Content="{Binding}" ContentTemplate="{StaticResource TopicBody}" AutomationProperties.Name="{Binding Title}" />
        </DataTemplate>

        <DataTemplate x:Key="LicenseExpander" DataType="{x:Type v:LicenseEntry}">
            <Expander Style="{StaticResource SettingsExpander}" AutomationProperties.Name="{Binding Name}">
                <Expander.Header>
                    <DockPanel>
                        <Border DockPanel.Dock="Left" Style="{StaticResource IconTile}">
                            <TextBlock Style="{StaticResource TileGlyph}" Text="{Binding Glyph}" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource CardTitle}" Text="{Binding Name}" />
                            <TextBlock Style="{StaticResource CardDesc}" Text="{Binding Meta}" />
                        </StackPanel>
                    </DockPanel>
                </Expander.Header>
                <StackPanel>
                    <TextBlock Style="{StaticResource BodyText}" Text="{Binding Copyright}" />
                    <TextBlock Style="{StaticResource BodyText}" Text="{Binding Note}" Margin="0,6,0,0"
                               Visibility="{Binding HasNote, Converter={StaticResource BoolToVis}}" />
                    <StackPanel Visibility="{Binding HasText, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{x:Static local:Loc.LicenseText}" FontSize="14" FontWeight="SemiBold" Margin="0,14,0,8" />
                        <Border Padding="14,12" CornerRadius="6" Background="{DynamicResource ControlFillColorDefaultBrush}"
                                BorderThickness="1" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                            <TextBlock Text="{Binding Text}" TextWrapping="Wrap" FontSize="12" LineHeight="18"
                                       FontFamily="Cascadia Mono, Consolas" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Expander>
        </DataTemplate>

        <!-- Yellow "Buy me a coffee" button with a small cup -->
        <Style x:Key="KofiButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="#FFDD63" CornerRadius="20" Padding="14,9,20,9">
                            <StackPanel Orientation="Horizontal">
                                <Viewbox Width="26" Height="22" Margin="0,0,10,0">
                                    <Canvas Width="26" Height="22">
                                        <Path Data="M2.5,3 H19 V12.5 A6.5,6.5 0 0 1 12.5,19 H9 A6.5,6.5 0 0 1 2.5,12.5 Z"
                                              Fill="White" Stroke="#202020" StrokeThickness="2.2" StrokeLineJoin="Round" />
                                        <Path Data="M19,6 H20.5 A3.6,3.6 0 0 1 20.5,13.2 H19" Stroke="#202020" StrokeThickness="2.2"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                        <Path Data="M10.8,15 C10.8,15 6.6,12.3 6.6,9.6 A2.2,2.2 0 0 1 10.8,8.8 A2.2,2.2 0 0 1 15,9.6 C15,12.3 10.8,15 10.8,15 Z"
                                              Fill="#FF5E5B" />
                                    </Canvas>
                                </Viewbox>
                                <TextBlock Text="{x:Static local:Loc.BuyCoffee}" FontSize="15" FontWeight="SemiBold"
                                           Foreground="#202020" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#FFE88A" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#F2CD4A" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="NavItem">
            <StackPanel Orientation="Horizontal" Height="36" ToolTip="{Binding Label}" Background="Transparent">
                <Grid Width="20" Height="20" Margin="0,0,16,0" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource NavGlyph}" Text="{Binding Glyph}" Margin="0" HorizontalAlignment="Center"
                               Visibility="{Binding ShowGlyph, Converter={StaticResource BoolToVis}}" />
                    <c:CoffeeCup Visibility="{Binding Animated, Converter={StaticResource BoolToVis}}" Margin="-1,-3,-1,0" />
                </Grid>
                <TextBlock Text="{Binding Label}" FontSize="14" VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsCompact, RelativeSource={RelativeSource AncestorType=v:SettingsView}}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="NavColumn" Width="272" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Left column: back + navigation -->
        <DockPanel Margin="4,0,4,8">
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="6,0,0,6" Height="36">
                <Button Style="{StaticResource BackButton}" Click="Back_Click"
                        ToolTip="{x:Static local:Loc.Back}" AutomationProperties.Name="{x:Static local:Loc.Back}" />
                <TextBlock x:Name="SettingsCaption" Text="{x:Static local:Loc.Settings}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0,0,0" />
            </StackPanel>
            <ListBox x:Name="Nav" ItemTemplate="{StaticResource NavItem}" ItemContainerStyle="{StaticResource NavItemStyle}"
                     BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     SelectionChanged="Nav_SelectionChanged" />
        </DockPanel>

        <Border Grid.Column="1" Style="{StaticResource ContentLayer}">
        <ScrollViewer x:Name="ContentScroll" Padding="24,16,28,24" VerticalScrollBarVisibility="Auto">
            <Grid MaxWidth="1000" HorizontalAlignment="Stretch">
                <!-- ===== General ===== -->
                <StackPanel x:Name="GeneralPage">
                    <TextBlock Style="{StaticResource PageTitle}" Text="{x:Static local:Loc.General}" />
                    <TextBlock Style="{StaticResource PageSubtitle}" Text="{x:Static local:Loc.GeneralSubtitle}" Margin="0,4,0,24" />

                    <Border Style="{StaticResource Card}" Padding="20,18">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="/Assets/app.png" Width="72" Height="72" Margin="0,0,20,0" RenderOptions.BitmapScalingMode="HighQuality" />
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{x:Static local:Loc.AppName}" FontSize="22" FontWeight="SemiBold" />
                                <TextBlock FontSize="14" Margin="0,2,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                    <Run Text="{x:Static local:Loc.VersionLabel}" />
                                    <Run Text="{x:Static local:AppInfo.Version}" />
                                </TextBlock>
                                <TextBlock FontSize="13" Margin="0,2,0,0" Text="{x:Static local:Loc.AuthorLine}"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Locations -->
                    <TextBlock Style="{StaticResource SectionTitle}" Text="{x:Static local:Loc.Folders}" />
                    <Border Style="{StaticResource Card}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource IconTile}">
                                <TextBlock Style="{StaticResource TileGlyph}" Text="&#xE713;" />
                            </Border>
                            <TextBlock Grid.Column="1" Style="{StaticResource CardTitle}" Text="{x:Static local:Loc.DataFolderLabel}" VerticalAlignment="Center" />
                            <Border Grid.Column="2" Style="{StaticResource PathBox}" ToolTip="{x:Static local:AppInfo.DataFolderDisplay}">
                                <TextBlock Text="{x:Static local:AppInfo.DataFolderDisplay}" TextTrimming="CharacterEllipsis" />
                            </Border>
                            <Button Grid.Column="3" Margin="8,0,0,0" Padding="9,6" Click="CopyDataFolder_Click"
                                    ToolTip="{x:Static local:Loc.CopyPath}" AutomationProperties.Name="{x:Static local:Loc.CopyPath}">
                                <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE8C8;" />
                            </Button>
                            <Button Grid.Column="4" Margin="8,0,0,0" Content="{x:Static local:Loc.OpenFolder}" Click="OpenDataFolder_Click" />
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource IconTile}">
                                    <TextBlock Style="{StaticResource TileGlyph}" Text="&#xE7B8;" />
                                </Border>
                                <TextBlock Grid.Column="1" Style="{StaticResource CardTitle}" Text="{x:Static local:Loc.PacksFolderLabel}" VerticalAlignment="Center" />
                                <Border Grid.Column="2" Style="{StaticResource PathBox}" x:Name="PacksPathBox">
                                    <TextBlock x:Name="PacksPathText" TextTrimming="CharacterEllipsis" />
                                </Border>
                                <Button Grid.Column="3" Margin="8,0,0,0" x:Name="ChangePacksButton" Content="{x:Static local:Loc.Change}" Click="ChangePacksFolder_Click" />
                                <Button Grid.Column="4" Margin="8,0,0,0" Content="{x:Static local:Loc.OpenFolder}" Click="OpenPacksFolder_Click" />
                            </Grid>
                            <TextBlock Style="{StaticResource CardDesc}" Text="{x:Static local:Loc.PacksFolderDesc}" Margin="56,8,0,0" />
                            <StackPanel x:Name="MoveProgress" Margin="56,10,0,0" Visibility="Collapsed">
                                <TextBlock x:Name="MoveText" Style="{StaticResource CardDesc}" />
                                <c:BusyBar Margin="0,8,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource IconTile}">
                                <TextBlock Style="{StaticResource TileGlyph}" Text="&#xE8B7;" />
                            </Border>
                            <TextBlock Grid.Column="1" Style="{StaticResource CardTitle}" Text="{x:Static local:Loc.ProgramFolderLabel}" VerticalAlignment="Center" />
                            <Border Grid.Column="2" Style="{StaticResource PathBox}" ToolTip="{x:Static local:AppInfo.ProgramFolderDisplay}">
                                <TextBlock Text="{x:Static local:AppInfo.ProgramFolderDisplay}" TextTrimming="CharacterEllipsis" />
                            </Border>
                            <Button Grid.Column="3" Margin="8,0,0,0" Padding="9,6" Click="CopyProgramFolder_Click"
                                    ToolTip="{x:Static local:Loc.CopyPath}" AutomationProperties.Name="{x:Static local:Loc.CopyPath}">
                                <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE8C8;" />
                            </Button>
                            <Button Grid.Column="4" Margin="8,0,0,0" Content="{x:Static local:Loc.OpenFolder}" Click="OpenProgramFolder_Click" />
                        </Grid>
                    </Border>

                    <!-- Options -->
                    <TextBlock Style="{StaticResource SectionTitle}" Text="{x:Static local:Loc.Options}" />
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <DockPanel>
                                <Border DockPanel.Dock="Left" Style="{StaticResource IconTile}">
                                    <TextBlock Style="{StaticResource TileGlyph}" Text="&#xE774;" />
                                </Border>
                                <ComboBox x:Name="LanguageBox" DockPanel.Dock="Right" Width="230" VerticalAlignment="Center"
                                          DisplayMemberPath="Label" SelectionChanged="LanguageBox_SelectionChanged"
                                          AutomationProperties.Name="{x:Static local:Loc.OptLanguageTitle}" />
                                <StackPanel Margin="0,0,24,0" VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource CardTitle}" Text="{x:Static local:Loc.OptLanguageTitle}" />
                                    <TextBlock Style="{StaticResource CardDesc}" Text="{x:Static local:Loc.OptLanguageDesc}" />
                                </StackPanel>
                            </DockPanel>
                            <Border x:Name="RestartHint" Margin="56,12,0,0" Padding="12,8,8,8" CornerRadius="4" Visibility="Collapsed"
                                    Background="{DynamicResource SystemFillColorAttentionBackgroundBrush}"
                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Left" FontFamily="{StaticResource IconFont}" Text="&#xE946;" FontSize="14"
                                               VerticalAlignment="Center" Margin="0,0,10,0" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                    <Button DockPanel.Dock="Right" Content="{x:Static local:Loc.RestartNow}" Margin="12,0,0,0"
                                            Padding="12,5" VerticalAlignment="Center" Click="Restart_Click" Style="{DynamicResource AccentButtonStyle}" />
                                    <TextBlock Text="{x:Static local:Loc.RestartNeeded}" FontSize="13" VerticalAlignment="Center" TextWrapping="Wrap" />
                                </DockPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}">
                        <DockPanel>
                            <Border DockPanel.Dock="Left" Style="{StaticResource IconTile}">
                                <TextBlock Style="{StaticResource TileGlyph}" Text="&#xE790;" />
                            </Border>
                            <Button DockPanel.Dock="Right" VerticalAlignment="Center" Click="WindowsColors_Click">
                                <StackPanel Style="{StaticResource ButtonContent}">
                                    <TextBlock Text="{x:Static local:Loc.OpenWindowsColors}" />
                                    <TextBlock Style="{StaticResource IconText}" Text="&#xE8A7;" FontSize="12" Margin="8,0,0,0" />
                                </StackPanel>
                            </Button>
                            <StackPanel Margin="0,0,24,0" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource CardTitle}" Text="{x:Static local:Loc.OptThemeTitle}" />
                                <TextBlock Style="{StaticResource CardDesc}" Text="{x:Static local:Loc.OptThemeDesc}" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <Border Style="{StaticResource Card}">
                        <DockPanel>
                            <Border DockPanel.Dock="Left" Style="{StaticResource IconTile}">
                                <TextBlock Style="{StaticResource TileGlyph}" Text="&#xE8A5;" />
                            </Border>
                            <CheckBox x:Name="ExplorerMenuSwitch" DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center"
                                      Click="ExplorerMenuSwitch_Click" AutomationProperties.Name="{x:Static local:Loc.OptExplorerMenuTitle}" />
                            <StackPanel Margin="0,0,24,0" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource CardTitle}" Text="{x:Static local:Loc.OptExplorerMenuTitle}" />
                                <TextBlock Style="{StaticResource CardDesc}" Text="{x:Static local:Loc.OptExplorerMenuDesc}" TextWrapping="Wrap" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <Border Style="{StaticResource Card}">
                        <DockPanel>
                            <Border DockPanel.Dock="Left" Style="{StaticResource IconTile}">
                                <TextBlock Style="{StaticResource TileGlyph}" Text="&#xE91B;" />
                            </Border>
                            <CheckBox x:Name="ThumbFrameSwitch" DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center"
                                      Click="ThumbFrameSwitch_Click" AutomationProperties.Name="{x:Static local:Loc.OptThumbFrameTitle}" />
                            <StackPanel Margin="0,0,24,0" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource CardTitle}" Text="{x:Static local:Loc.OptThumbFrameTitle}" />
                                <TextBlock Style="{StaticResource CardDesc}" Text="{x:Static local:Loc.OptThumbFrameDesc}" TextWrapping="Wrap" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </StackPanel>

                <!-- ===== Help ===== -->
                <StackPanel x:Name="HelpPage" Visibility="Collapsed">
                    <TextBlock Style="{StaticResource PageTitle}" Text="{x:Static local:Loc.Help}" />
                    <TextBlock Style="{StaticResource PageSubtitle}" Text="{x:Static local:Loc.HelpSubtitle}" Margin="0,4,0,24" />
                    <ItemsControl x:Name="HelpList" ItemTemplate="{StaticResource TopicExpander}" Focusable="False" />
                </StackPanel>

                <!-- ===== Licenses & privacy ===== -->
                <StackPanel x:Name="LicensePage" Visibility="Collapsed">
                    <TextBlock Style="{StaticResource PageTitle}" Text="{x:Static local:Loc.LicensesNav}" />
                    <TextBlock Style="{StaticResource PageSubtitle}" Text="{x:Static local:Loc.LicensesSubtitle}" Margin="0,4,0,24" />
                    <TextBlock Style="{StaticResource SectionTitle}" Margin="2,0,0,8" Text="{x:Static local:Loc.Licenses}" />
                    <ItemsControl x:Name="LicenseList" ItemTemplate="{StaticResource LicenseExpander}" Focusable="False" />
                    <TextBlock Style="{StaticResource SectionTitle}" Text="{x:Static local:Loc.Privacy}" />
                    <ContentControl x:Name="PrivacyBox" ContentTemplate="{StaticResource TopicExpander}" Focusable="False" />
                </StackPanel>

                <!-- ===== Support ===== -->
                <StackPanel x:Name="SupportPage" Visibility="Collapsed">
                    <TextBlock Style="{StaticResource PageTitle}" Text="{x:Static local:Loc.Support}" />
                    <TextBlock Style="{StaticResource PageSubtitle}" Text="{x:Static local:Loc.SupportSubtitle}" Margin="0,4,0,24" />
                    <Border Style="{StaticResource Card}" Padding="28,26">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <c:CoffeeCup Width="128" Height="128" VerticalAlignment="Top" Margin="0,0,32,0" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{x:Static local:Loc.SupportHeadline}" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock Style="{StaticResource BodyText}" Text="{x:Static local:Loc.SupportText}" Margin="0,10,0,18" />
                                <Button Style="{StaticResource KofiButton}" HorizontalAlignment="Left" Click="Kofi_Click"
                                        ToolTip="{x:Static local:AppInfo.KofiUrl}" AutomationProperties.Name="{x:Static local:Loc.BuyCoffee}" />
                                <WrapPanel Margin="0,16,0,0">
                                    <TextBlock Text="{x:Static local:Loc.SupportVoluntary}" FontSize="12" Margin="0,0,12,0"
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />
                                    <Button Style="{StaticResource LinkButton}" Content="{x:Static local:AppInfo.KofiLabel}" FontSize="12" Click="Kofi_Click" />
                                </WrapPanel>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Other ways to help -->
                    <TextBlock Style="{StaticResource SectionTitle}" Text="{x:Static local:Loc.MoreWays}" />
                    <UniformGrid Columns="3" Margin="-2,0,-2,0">
                        <Border Style="{StaticResource Card}" Margin="2,0,2,4" Padding="18,16">
                            <StackPanel>
                                <TextBlock Style="{StaticResource TileGlyph}" HorizontalAlignment="Left" Text="&#xE72D;" FontSize="20" Margin="0,0,0,12" />
                                <TextBlock Style="{StaticResource CardTitle}" FontWeight="SemiBold" Text="{x:Static local:Loc.ShareTitle}" />
                                <TextBlock Style="{StaticResource CardDesc}" FontSize="13" Margin="0,6,0,0" Text="{x:Static local:Loc.ShareText}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Margin="2,0,2,4" Padding="18,16">
                            <DockPanel>
                                <Button DockPanel.Dock="Bottom" Style="{StaticResource LinkButton}" Margin="0,12,0,0" HorizontalAlignment="Left"
                                        Content="{x:Static local:Loc.StarLink}" Click="GitHub_Click" ToolTip="{x:Static local:AppInfo.GitHubUrl}" />
                                <StackPanel>
                                    <TextBlock Style="{StaticResource TileGlyph}" HorizontalAlignment="Left" Text="&#xE734;" FontSize="20" Margin="0,0,0,12" />
                                    <TextBlock Style="{StaticResource CardTitle}" FontWeight="SemiBold" Text="{x:Static local:Loc.StarTitle}" />
                                    <TextBlock Style="{StaticResource CardDesc}" FontSize="13" Margin="0,6,0,0" Text="{x:Static local:Loc.StarText}" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Margin="2,0,2,4" Padding="18,16">
                            <DockPanel>
                                <Button DockPanel.Dock="Bottom" Style="{StaticResource LinkButton}" Margin="0,12,0,0" HorizontalAlignment="Left"
                                        Content="{x:Static local:Loc.FeedbackLink}" Click="Issue_Click" ToolTip="{x:Static local:AppInfo.GitHubIssuesUrl}" />
                                <StackPanel>
                                    <TextBlock Style="{StaticResource TileGlyph}" HorizontalAlignment="Left" Text="&#xED15;" FontSize="20" Margin="0,0,0,12" />
                                    <TextBlock Style="{StaticResource CardTitle}" FontWeight="SemiBold" Text="{x:Static local:Loc.FeedbackTitle}" />
                                    <TextBlock Style="{StaticResource CardDesc}" FontSize="13" Margin="0,6,0,0" Text="{x:Static local:Loc.FeedbackText}" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </UniformGrid>
                </StackPanel>
            </Grid>
        </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
