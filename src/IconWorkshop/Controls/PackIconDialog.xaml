<Window x:Class="IconWorkshop.Controls.PackIconDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:IconWorkshop"
        xmlns:c="clr-namespace:IconWorkshop.Controls"
        Title="{x:Static local:Loc.NavLibrary}" Width="760" Height="600" MinWidth="560" MinHeight="420"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="CanResize"
        Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <!-- Picks an icon from the imported packs (e.g. as a layer in the icon maker) -->
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock x:Name="TitleText" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,12" />
        <c:IconBrowser x:Name="Browser" Grid.Row="1" />
        <DockPanel Grid.Row="2" Margin="0,16,0,0" LastChildFill="False">
            <Button DockPanel.Dock="Right" Content="{x:Static local:Loc.Cancel}" Click="Cancel_Click" MinWidth="110" Margin="8,0,0,0" IsCancel="True" />
            <Button x:Name="OkButton" DockPanel.Dock="Right" Style="{DynamicResource AccentButtonStyle}" Click="Ok_Click" MinWidth="110" IsDefault="True" IsEnabled="False" />
            <TextBlock x:Name="SelectedText" VerticalAlignment="Center" Style="{StaticResource SecondaryText}" FontSize="13" />
        </DockPanel>
    </Grid>
</Window>
