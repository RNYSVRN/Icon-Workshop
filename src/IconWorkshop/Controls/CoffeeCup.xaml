<UserControl x:Class="IconWorkshop.Controls.CoffeeCup"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             IsHitTestVisible="False" Focusable="False">
    <!-- Coffee cup with a heart and rising steam. Scales freely (Viewbox, 64 grid).
         The stroke adapts to light/dark, the heart uses the Windows accent color. -->
    <UserControl.Resources>
        <Style x:Key="Steam" TargetType="Path">
            <Setter Property="Stroke" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="StrokeThickness" Value="4" />
            <Setter Property="StrokeStartLineCap" Value="Round" />
            <Setter Property="StrokeEndLineCap" Value="Round" />
            <Setter Property="Opacity" Value="0" />
        </Style>

        <!-- One steam wisp: rises, fades in and out again -->
        <Storyboard x:Key="SteamLoop">
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Steam1" Storyboard.TargetProperty="Opacity" Duration="0:0:2.4" RepeatBehavior="Forever">
                <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                <LinearDoubleKeyFrame KeyTime="0:0:0.6" Value="0.9" />
                <LinearDoubleKeyFrame KeyTime="0:0:1.6" Value="0" />
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Steam1Move" Storyboard.TargetProperty="Y" Duration="0:0:2.4" RepeatBehavior="Forever">
                <LinearDoubleKeyFrame KeyTime="0:0:0" Value="4" />
                <LinearDoubleKeyFrame KeyTime="0:0:1.6" Value="-6" />
                <DiscreteDoubleKeyFrame KeyTime="0:0:2.4" Value="-6" />
            </DoubleAnimationUsingKeyFrames>

            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Steam2" Storyboard.TargetProperty="Opacity" Duration="0:0:2.4" RepeatBehavior="Forever" BeginTime="0:0:0.8">
                <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                <LinearDoubleKeyFrame KeyTime="0:0:0.6" Value="0.9" />
                <LinearDoubleKeyFrame KeyTime="0:0:1.6" Value="0" />
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Steam2Move" Storyboard.TargetProperty="Y" Duration="0:0:2.4" RepeatBehavior="Forever" BeginTime="0:0:0.8">
                <LinearDoubleKeyFrame KeyTime="0:0:0" Value="4" />
                <LinearDoubleKeyFrame KeyTime="0:0:1.6" Value="-6" />
                <DiscreteDoubleKeyFrame KeyTime="0:0:2.4" Value="-6" />
            </DoubleAnimationUsingKeyFrames>

            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Steam3" Storyboard.TargetProperty="Opacity" Duration="0:0:2.4" RepeatBehavior="Forever" BeginTime="0:0:1.6">
                <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                <LinearDoubleKeyFrame KeyTime="0:0:0.6" Value="0.9" />
                <LinearDoubleKeyFrame KeyTime="0:0:1.6" Value="0" />
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Steam3Move" Storyboard.TargetProperty="Y" Duration="0:0:2.4" RepeatBehavior="Forever" BeginTime="0:0:1.6">
                <LinearDoubleKeyFrame KeyTime="0:0:0" Value="4" />
                <LinearDoubleKeyFrame KeyTime="0:0:1.6" Value="-6" />
                <DiscreteDoubleKeyFrame KeyTime="0:0:2.4" Value="-6" />
            </DoubleAnimationUsingKeyFrames>

            <!-- Heart beats gently -->
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="HeartScale" Storyboard.TargetProperty="ScaleX" Duration="0:0:2.4" RepeatBehavior="Forever">
                <EasingDoubleKeyFrame KeyTime="0:0:0" Value="1" />
                <EasingDoubleKeyFrame KeyTime="0:0:0.2" Value="1.14" />
                <EasingDoubleKeyFrame KeyTime="0:0:0.4" Value="1" />
                <EasingDoubleKeyFrame KeyTime="0:0:0.6" Value="1.1" />
                <EasingDoubleKeyFrame KeyTime="0:0:0.9" Value="1" />
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="HeartScale" Storyboard.TargetProperty="ScaleY" Duration="0:0:2.4" RepeatBehavior="Forever">
                <EasingDoubleKeyFrame KeyTime="0:0:0" Value="1" />
                <EasingDoubleKeyFrame KeyTime="0:0:0.2" Value="1.14" />
                <EasingDoubleKeyFrame KeyTime="0:0:0.4" Value="1" />
                <EasingDoubleKeyFrame KeyTime="0:0:0.6" Value="1.1" />
                <EasingDoubleKeyFrame KeyTime="0:0:0.9" Value="1" />
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>
    </UserControl.Resources>

    <UserControl.Triggers>
        <EventTrigger RoutedEvent="UserControl.Loaded">
            <BeginStoryboard Storyboard="{StaticResource SteamLoop}" />
        </EventTrigger>
    </UserControl.Triggers>

    <Viewbox>
        <Canvas Width="64" Height="64">
            <!-- Steam: three curved wisps -->
            <Path x:Name="Steam1" Style="{StaticResource Steam}" Data="M22,21 C18.5,17 25.5,14 22,9">
                <Path.RenderTransform><TranslateTransform x:Name="Steam1Move" /></Path.RenderTransform>
            </Path>
            <Path x:Name="Steam2" Style="{StaticResource Steam}" Data="M31,19 C27.5,15 34.5,12 31,7">
                <Path.RenderTransform><TranslateTransform x:Name="Steam2Move" /></Path.RenderTransform>
            </Path>
            <Path x:Name="Steam3" Style="{StaticResource Steam}" Data="M40,21 C36.5,17 43.5,14 40,9">
                <Path.RenderTransform><TranslateTransform x:Name="Steam3Move" /></Path.RenderTransform>
            </Path>

            <!-- Cup and handle -->
            <Path Data="M12,27 H50 V40 A13,13 0 0 1 37,53 H25 A13,13 0 0 1 12,40 Z"
                  Stroke="{DynamicResource TextFillColorPrimaryBrush}" StrokeThickness="4.5" StrokeLineJoin="Round" />
            <Path Data="M50,31 H53 A6.5,6.5 0 0 1 53,44 H49"
                  Stroke="{DynamicResource TextFillColorPrimaryBrush}" StrokeThickness="4.5"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />

            <!-- Heart -->
            <Path Data="M31,47.5 C31,47.5 22,42 22,36.2 A4.6,4.6 0 0 1 31,34.4 A4.6,4.6 0 0 1 40,36.2 C40,42 31,47.5 31,47.5 Z"
                  Fill="{DynamicResource AccentFillColorDefaultBrush}" RenderTransformOrigin="0.5,0.55">
                <Path.RenderTransform><ScaleTransform x:Name="HeartScale" /></Path.RenderTransform>
            </Path>
        </Canvas>
    </Viewbox>
</UserControl>
