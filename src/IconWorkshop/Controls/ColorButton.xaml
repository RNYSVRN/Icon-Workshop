<UserControl x:Class="IconWorkshop.Controls.ColorButton"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:IconWorkshop">
    <!-- Color swatch button that opens a full color picker: saturation/brightness field, hue, opacity,
         recently used colors, a few suggestions and (optional) hex input. -->
    <Grid>
        <ToggleButton x:Name="Toggle" Padding="6,4" MinWidth="0" IsChecked="{Binding IsOpen, ElementName=Popup, Mode=TwoWay}"
                      AutomationProperties.Name="{x:Static local:Loc.T_Color}">
            <StackPanel Orientation="Horizontal">
                <Grid Width="40" Height="20">
                    <!-- Checkerboard shows transparency -->
                    <Rectangle RadiusX="4" RadiusY="4">
                        <Rectangle.Fill>
                            <DrawingBrush TileMode="Tile" Viewport="0,0,8,8" ViewportUnits="Absolute">
                                <DrawingBrush.Drawing>
                                    <DrawingGroup>
                                        <GeometryDrawing Brush="#FFFFFF" Geometry="M0,0 H2 V2 H0 Z" />
                                        <GeometryDrawing Brush="#CCCCCC" Geometry="M0,0 H1 V1 H0 Z M1,1 H2 V2 H1 Z" />
                                    </DrawingGroup>
                                </DrawingBrush.Drawing>
                            </DrawingBrush>
                        </Rectangle.Fill>
                    </Rectangle>
                    <Rectangle x:Name="Swatch" RadiusX="4" RadiusY="4" Stroke="{DynamicResource ControlStrokeColorDefaultBrush}" />
                </Grid>
                <TextBlock Style="{StaticResource IconText}" Text="&#xE70D;" FontSize="10" Margin="8,1,0,0" />
            </StackPanel>
        </ToggleButton>

        <Popup x:Name="Popup" PlacementTarget="{Binding ElementName=Toggle}" Placement="Bottom" StaysOpen="False"
               AllowsTransparency="True" PopupAnimation="Fade" Closed="Popup_Closed">
            <Border Margin="8" CornerRadius="8" BorderThickness="1" Padding="14"
                    Background="{DynamicResource SolidBackgroundFillColorBaseBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.3" />
                </Border.Effect>
                <StackPanel Width="276">
                    <StackPanel Orientation="Horizontal">
                        <!-- Saturation (x) and brightness (y) for the current hue -->
                        <Grid x:Name="SvArea" Width="220" Height="160" Cursor="Cross" Background="Transparent" ClipToBounds="True"
                              MouseLeftButtonDown="Sv_MouseDown" MouseMove="Sv_MouseMove" MouseLeftButtonUp="Sv_MouseUp">
                            <Rectangle x:Name="SvHue" RadiusX="4" RadiusY="4" />
                            <Rectangle RadiusX="4" RadiusY="4">
                                <Rectangle.Fill>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#FFFFFFFF" Offset="0" />
                                        <GradientStop Color="#00FFFFFF" Offset="1" />
                                    </LinearGradientBrush>
                                </Rectangle.Fill>
                            </Rectangle>
                            <Rectangle RadiusX="4" RadiusY="4">
                                <Rectangle.Fill>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#00000000" Offset="0" />
                                        <GradientStop Color="#FF000000" Offset="1" />
                                    </LinearGradientBrush>
                                </Rectangle.Fill>
                            </Rectangle>
                            <Canvas IsHitTestVisible="False">
                                <Ellipse x:Name="SvThumb" Width="14" Height="14" Stroke="White" StrokeThickness="2">
                                    <Ellipse.Effect><DropShadowEffect BlurRadius="3" ShadowDepth="0" Opacity="0.8" /></Ellipse.Effect>
                                </Ellipse>
                            </Canvas>
                        </Grid>
                        <!-- Hue -->
                        <Grid x:Name="HueArea" Width="22" Height="160" Margin="12,0,0,0" Cursor="Hand" Background="Transparent"
                              MouseLeftButtonDown="Hue_MouseDown" MouseMove="Hue_MouseMove" MouseLeftButtonUp="Hue_MouseUp">
                            <Rectangle RadiusX="4" RadiusY="4">
                                <Rectangle.Fill>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#FF0000" Offset="0" />
                                        <GradientStop Color="#FFFF00" Offset="0.167" />
                                        <GradientStop Color="#00FF00" Offset="0.333" />
                                        <GradientStop Color="#00FFFF" Offset="0.5" />
                                        <GradientStop Color="#0000FF" Offset="0.667" />
                                        <GradientStop Color="#FF00FF" Offset="0.833" />
                                        <GradientStop Color="#FF0000" Offset="1" />
                                    </LinearGradientBrush>
                                </Rectangle.Fill>
                            </Rectangle>
                            <Canvas IsHitTestVisible="False">
                                <Border x:Name="HueThumb" Width="26" Height="8" CornerRadius="4" BorderBrush="White" BorderThickness="2" Canvas.Left="-2">
                                    <Border.Effect><DropShadowEffect BlurRadius="3" ShadowDepth="0" Opacity="0.8" /></Border.Effect>
                                </Border>
                            </Canvas>
                        </Grid>
                    </StackPanel>

                    <!-- Opacity -->
                    <DockPanel Margin="0,12,0,0">
                        <TextBlock DockPanel.Dock="Left" Text="{x:Static local:Loc.T_Opacity}" Style="{StaticResource CardDesc}" VerticalAlignment="Center" Width="70" />
                        <TextBlock x:Name="AlphaText" DockPanel.Dock="Right" Style="{StaticResource CardDesc}" VerticalAlignment="Center" Width="36" TextAlignment="Right" />
                        <Slider x:Name="AlphaSlider" Minimum="0" Maximum="100" ValueChanged="Alpha_ValueChanged" />
                    </DockPanel>

                    <!-- Suggestions and recently used -->
                    <TextBlock Text="{x:Static local:Loc.T_Suggestions}" Style="{StaticResource CardDesc}" Margin="0,10,0,6" />
                    <WrapPanel x:Name="PresetPanel" />
                    <TextBlock x:Name="RecentTitle" Text="{x:Static local:Loc.T_Recent}" Style="{StaticResource CardDesc}" Margin="0,6,0,6" />
                    <WrapPanel x:Name="RecentPanel" />

                    <!-- Hex (optional): small row, only needed when entering exact values -->
                    <DockPanel Margin="0,10,0,0">
                        <TextBlock Text="{x:Static local:Loc.T_HexValue}" Style="{StaticResource CardDesc}" VerticalAlignment="Center" Width="70" Margin="0" />
                        <TextBox x:Name="HexBox" Width="120" HorizontalAlignment="Left" Padding="10,5" VerticalContentAlignment="Center"
                                 KeyDown="HexBox_KeyDown" LostFocus="HexBox_LostFocus" />
                    </DockPanel>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>
