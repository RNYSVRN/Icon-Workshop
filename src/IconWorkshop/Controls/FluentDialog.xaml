<Window x:Class="IconWorkshop.Controls.FluentDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterOwner">
    <!-- Dialog like the Windows 11 ContentDialog: title, text, optional input, button bar. -->
    <Border Margin="24" CornerRadius="8" BorderThickness="1"
            Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="8" Opacity="0.35" />
        </Border.Effect>
        <Grid Width="460">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Margin="24,22,24,24">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <Border Width="32" Height="32" CornerRadius="16" Margin="0,0,12,0"
                            Background="{DynamicResource ControlFillColorSecondaryBrush}" VerticalAlignment="Center">
                        <TextBlock x:Name="IconGlyph" FontFamily="{StaticResource IconFont}" FontSize="16"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                    </Border>
                    <TextBlock x:Name="TitleText" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="360"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                </StackPanel>
                <TextBlock x:Name="MessageText" FontSize="14" LineHeight="21" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                <TextBox x:Name="InputBox" Margin="0,12,0,0" Visibility="Collapsed" />
                <TextBlock x:Name="NoteText" FontSize="13" LineHeight="19" TextWrapping="Wrap" Margin="0,10,0,0"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" Visibility="Collapsed" />
            </StackPanel>

            <Border Grid.Row="1" CornerRadius="0,0,7,7" BorderThickness="0,1,0,0" Padding="24"
                    Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                <UniformGrid x:Name="Buttons" Rows="1">
                    <Button x:Name="PrimaryButton" Style="{DynamicResource AccentButtonStyle}" Margin="0,0,4,0"
                            HorizontalAlignment="Stretch" Padding="12,6" Click="Primary_Click" IsDefault="True" />
                    <Button x:Name="SecondaryButton" Margin="4,0,4,0" HorizontalAlignment="Stretch" Padding="12,6" Click="Secondary_Click" />
                    <Button x:Name="CloseButton" Margin="4,0,0,0" HorizontalAlignment="Stretch" Padding="12,6" Click="Close_Click" IsCancel="True" />
                </UniformGrid>
            </Border>
        </Grid>
    </Border>
</Window>
